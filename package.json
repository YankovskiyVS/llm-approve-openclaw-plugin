{
  "name": "openclaw-llm-action-judge",
  "version": "0.5.1",
  "private": true,
  "description": "LLM-gated tool-call approval for OpenClaw",
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://git.sbercloud.tech/ai_transformation/poc-and-eda/llm-approve-openclaw-plugin.git"
  },
  "files": [
    ".env.example",
    "index.js",
    "openclaw.plugin.json",
    "schemas/",
    "src/",
    "README.md",
    "CONTRACT.md",
    "DEPLOYMENT.md",
    "RND.md",
    "HOLDOUT.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "eval:harness": "node evals/benchmark.mjs",
    "eval:preflight": "node evals/candidate-preflight.mjs",
    "eval:selection": "node evals/candidate-selection.mjs",
    "eval:holdout:freeze": "node evals/holdout-freeze.mjs",
    "eval:holdout:audit": "node evals/holdout-partition-audit.mjs",
    "eval:holdout:infer": "node evals/holdout-infer.mjs",
    "eval:holdout:score": "node evals/holdout-score.mjs",
    "eval:smoke": "node evals/dev-smoke.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.7.1-2"
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    }
  }
}
