{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "action_hash",
    "decision",
    "risk",
    "authorization",
    "confidence",
    "rationale"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "const": "2026-07-14.6"
    },
    "action_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "review"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "authorization": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
