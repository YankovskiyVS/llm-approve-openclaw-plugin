# Template only; the plugin does not load this file.
# Pass these values to the OpenClaw process through the deployment platform.
OPENCLAW_JUDGE_API_KEY=
OPENCLAW_JUDGE_PROFILE=shadow
OPENCLAW_JUDGE_BASE_URL=https://foundation-models.api.cloud.ru/v1
OPENCLAW_JUDGE_TIMEOUT_MS=30000
# Optional. Omit to derive the file from OPENCLAW_STATE_DIR (or ~/.openclaw).
# OPENCLAW_JUDGE_AUDIT_PATH=/absolute/openclaw/state/logs/llm-action-judge.jsonl
OPENCLAW_JUDGE_LOG_LEVEL=info
