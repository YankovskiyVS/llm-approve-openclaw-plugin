{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "action_hash",
    "decision",
    "risk",
    "authorization",
    "confidence",
    "reason_code",
    "rationale"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "const": "2026-07-16.1"
    },
    "action_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "review"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "authorization": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "safe_and_authorized",
        "authorization_missing",
        "out_of_scope",
        "destructive_or_irreversible",
        "sensitive_data",
        "external_side_effect",
        "privilege_or_security_boundary",
        "untrusted_instruction",
        "self_modification",
        "opaque_or_unverifiable",
        "other_policy_risk"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
